# Copy this file to ".env" and fill in your real values.
# ".env" is gitignored — never commit real credentials.

# MongoDB Atlas connection string (replace <db_password> with the real password).
# Get it from Atlas: Cluster -> Connect -> Drivers.
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>

# Database name
DB_NAME=beeworking
