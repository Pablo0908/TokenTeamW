# --- API ---
# Base URL of the Flask API. Local dev points at the backend on localhost:5000.
# In production (Vercel) set this to the Render API origin, e.g.
#   VITE_API_URL=https://tokenteamw-api.onrender.com
VITE_API_URL=http://localhost:5000

# --- Demo / mock mode ---
# When "true", the app serves built-in sample data (no backend needed) so you can
# preview every screen exactly as designed. Set to "false" once the Flask API is
# running and VITE_API_URL points at it.
VITE_USE_MOCK=true

# Base URL the QR codes encode (the deployed frontend origin). Used by the admin
# panel when displaying the redeem link for a generated QR.
VITE_PUBLIC_URL=http://localhost:5173
