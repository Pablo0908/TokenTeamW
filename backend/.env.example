# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.

# --- MongoDB Atlas (SRV connection string) ---
# Atlas -> Cluster -> Connect -> Drivers. Replace <user>, <password>, <cluster>.
# The database name (beeworking) is in the path; flask reads it via DB_NAME below.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/beeworking?retryWrites=true&w=majority
DB_NAME=beeworking

# --- Auth secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
JWT_SECRET=replace-with-a-long-random-string
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRY_HOURS=8

# --- Frontend origin ---
# Used for CORS AND for the URL encoded into every badge QR ({FRONTEND_URL}/redeem/<event_id>/<token>).
# In production set this to the Vercel URL BEFORE generating any QR codes.
FRONTEND_URL=http://localhost:5173
# Comma-separated CORS allow-list (defaults to localhost:5173 + FRONTEND_URL if blank).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- First admin account (used by: python seed_admin.py) ---
ADMIN_EMAIL=admin@lyfter.cc
ADMIN_PASSWORD=change-me-strong
ADMIN_NAME=Admin
ADMIN_LASTNAME=Lyfter

FLASK_ENV=development
PORT=5000
