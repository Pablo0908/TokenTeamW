# Copy this file to ".env" and fill in real values. ".env" is gitignored — never commit it.
# In production, set these as host secrets (Render dashboard) — do NOT ship a .env.

# --- MongoDB Atlas (SRV connection string) ---
# Atlas -> Cluster -> Connect -> Drivers. Replace <user>, <password>, <cluster>.
# DB_NAME selects the database; the name in the URI path is ignored by the app.
#   dev  : DB_NAME=beeworking
#   prod : DB_NAME=beeworking_prod   (separate database in the same cluster)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=beeworking

# --- Auth secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
# Production MUST use fresh secrets — never reuse the dev values. Rotating JWT_SECRET
# invalidates all existing tokens (users must log in again); that is expected.
JWT_SECRET=replace-with-a-long-random-string
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRY_HOURS=8

# --- Frontend origin ---
# Used for CORS AND for the URL encoded into every badge QR ({FRONTEND_URL}/redeem/...).
# In production set this to the deployed Vercel HTTPS URL BEFORE generating any QR codes.
#   dev  : http://127.0.0.1:5173
#   prod : https://<your-app>.vercel.app   (or your custom domain)
FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated CORS allow-list. In production set this to the prod origin ONLY
# (no localhost). Defaults to 127.0.0.1:5173 + localhost + FRONTEND_URL if left blank.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- First admin account (used by: python seed_admin.py) ---
# Fill these in your local .env ONLY (gitignored). Leave blank here — never commit
# a real admin email or password. seed_admin.py refuses to run if EMAIL/PASSWORD are unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_LASTNAME=

# --- Google Sign-In ---
# Public OAuth client ID; MUST match VITE_GOOGLE_CLIENT_ID in the frontend build, and
# the deployed frontend origin must be an Authorized JavaScript origin in Google Cloud.
GOOGLE_CLIENT_ID=

# --- Email (2FA OTP, password reset, invites) ---
# Leave blank to log codes to the console instead of emailing (dev convenience).
# MAIL_FROM must be a well-formed address — use the "Name <addr>" form WITH angle brackets.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Lyfter <you@example.com>

# --- Runtime ---
FLASK_ENV=development
PORT=5000
# Rate-limit storage. Default in-memory is fine for a single worker; in production with
# multiple gunicorn workers point this at Redis so limits hold across workers.
#   prod (optional): RATELIMIT_STORAGE_URI=redis://<host>:6379
RATELIMIT_STORAGE_URI=memory://
